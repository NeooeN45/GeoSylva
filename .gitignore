# Gradle
.gradle/
**/build/

# Keystore & signing
*.jks
*.keystore
keystore.properties
keystore/

# Données SIG / shapefiles (ne pas publier)
*.shp
*.dbf
*.shx
*.prj
*.cpg

# Tuiles DEM SRTM (binaires volumineux ~1.4 GB, copiés via script)
# Voir scripts/copy_dem_tiles.ps1 pour synchroniser depuis le disque D:
dem_pack/src/main/assets/dem_tiles/*.hgt
dem_pack/src/main/assets/dem_tiles/**/*.hgt
dem_pack/src/main/assets/dem_tiles/*.zip

# IDE
.idea/
*.iml
local.properties

# Build logs
buildlog.txt
kotlinlog.txt
build_errors.txt
build_log.txt
release_build.txt

# Crash logs
temp_crash_logs/
*.txt
# Required attribution/licence files bundled with Android assets.
!app/src/main/assets/fonts/NOTICE.txt
!app/src/main/assets/fonts/LICENSE-OpenSans-Apache-2.0.txt
!app/src/main/assets/fonts/LICENSE-MapLibre-DemoTiles-BSD-3-Clause.txt
!app/src/main/assets/onf_parcel_terms.txt
!app/src/main/res/raw/registration_nature_credits.txt
# Exception : SHA256SUMS.txt du corpus d'interopérabilité capsule doit être
# versionné (le test InteropFixturesTest vérifie son intégrité en CI).
!capsule-verifier/src/test/resources/**/SHA256SUMS.txt

# OS files
.DS_Store
Thumbs.db
desktop.ini
nul

# Archives & large files at root
/*.zip
/*.png

# Scratch / reference code
martelage_calcul/

