+    private fun validateJsonNesting(bytes: ByteArray) {
+        val charset = when {
+            bytes.size >= 2 && bytes[0] == 0xFF.toByte() && bytes[1] == 0xFE.toByte() -> Charsets.UTF_16LE
+            bytes.size >= 2 && bytes[0] == 0xFE.toByte() && bytes[1] == 0xFF.toByte() -> Charsets.UTF_16BE
+            else -> Charsets.UTF_8
+        }
+        val text = charset.newDecoder().onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)
+            .decode(java.nio.ByteBuffer.wrap(bytes)).toString()
+        var quoted = false
+        var escaped = false
+        var depth = 0
+        text.forEach { char ->
+            if (quoted) {
+                if (escaped) escaped = false else if (char == '\\') escaped = true else if (char == '"') quoted = false
+            } else when (char) {
+                '"' -> quoted = true
+                '{', '[' -> if (++depth > 32) layerFail(LayerStoreError.LIMIT_EXCEEDED)
+                '}', ']' -> if (--depth < 0) layerFail(LayerStoreError.INVALID_INPUT)
+            }
+        }
+        if (quoted || depth != 0) layerFail(LayerStoreError.INVALID_INPUT)
+    }
+
+    private data class XmlFeature(val properties: JsonObject, val geometry: JsonObject? = null)
+
+    /** Validates every coordinate; GPX segments stay independent, including isolated points. */
+    private fun validateXml(bytes: ByteArray, format: LayerImportFormat): List<XmlFeature> {
+        val text = Charsets.UTF_8.newDecoder().onMalformedInput(java.nio.charset.CodingErrorAction.REPORT)
+            .decode(java.nio.ByteBuffer.wrap(bytes)).toString()
+        if ('\u0000' in text || Regex("<!\\s*(DOCTYPE|ENTITY)", RegexOption.IGNORE_CASE).containsMatchIn(text)) layerFail(LayerStoreError.INVALID_INPUT)
+        val parser = android.util.Xml.newPullParser().apply {
+            setFeature(org.xmlpull.v1.XmlPullParser.FEATURE_PROCESS_NAMESPACES, false)
+            setInput(java.io.StringReader(text))
+        }
+        val stack = mutableListOf<String>()
+        val features = mutableListOf<XmlFeature>()
+        val fields = mutableMapOf<String, JsonElement>()
+        val content = StringBuilder()
+        var geometryCount = 0
+        var coordinateCount = 0
+        var geometry = ""
+        var section: String? = null
+        var totalPositions = 0
+        val segments = mutableListOf<List<JsonArray>>()
+        var segment = mutableListOf<JsonArray>()
+        var currentPoint: MutableList<Double>? = null
+        var waypoint: JsonArray? = null
+        fun pointGeometry(position: JsonArray) = buildJsonObject { put("type", "Point"); put("coordinates", position) }
+        fun lineGeometry(positions: List<JsonArray>) = buildJsonObject { put("type", "LineString"); put("coordinates", JsonArray(positions)) }
+        fun segmentedGeometry(parts: List<List<JsonArray>>): JsonObject {
+            if (parts.isEmpty() || parts.any { it.isEmpty() }) layerFail(LayerStoreError.INVALID_GEOMETRY)
+            if (parts.size == 1) return if (parts.single().size == 1) pointGeometry(parts.single().single()) else lineGeometry(parts.single())
+            return if (parts.all { it.size >= 2 }) buildJsonObject {
+                put("type", "MultiLineString"); put("coordinates", JsonArray(parts.map(::JsonArray)))
+            } else buildJsonObject {
+                put("type", "GeometryCollection"); put("geometries", JsonArray(parts.map { if (it.size == 1) pointGeometry(it.single()) else lineGeometry(it) }))
+            }
+        }
+        var event = parser.eventType
+        while (event != org.xmlpull.v1.XmlPullParser.END_DOCUMENT) {
+            when (event) {
+                org.xmlpull.v1.XmlPullParser.START_TAG -> {
+                    val tag = parser.name.substringAfterLast(':').lowercase()
+                    if (stack.size >= 32) layerFail(LayerStoreError.LIMIT_EXCEEDED)
+                    val parent = stack.lastOrNull()
+                    stack += tag; content.clear()
+                    if (format == LayerImportFormat.KML) {
+                        if (tag in setOf("multigeometry", "model", "track", "multitrack", "networklink")) layerFail(LayerStoreError.UNSUPPORTED_FORMAT)
+                        if (tag == "placemark") {
+                            if (section != null) layerFail(LayerStoreError.INVALID_INPUT)
+                            section = tag; fields.clear(); geometryCount = 0; coordinateCount = 0
+                        }
+                        if (section != null && tag in setOf("point", "linestring", "polygon")) { geometryCount++; geometry = tag }
+                    } else {
+                        if (tag in setOf("wpt", "trk", "rte")) {
+                            if (section != null || parent != "gpx") layerFail(LayerStoreError.INVALID_INPUT)
+                            section = tag; fields.clear(); segments.clear(); segment = mutableListOf(); waypoint = null
+                        }
+                        if (tag == "trkseg") {
+                            if (section != "trk" || parent != "trk") layerFail(LayerStoreError.INVALID_INPUT)
+                            segment = mutableListOf()
+                        }
+                        if (tag in setOf("wpt", "trkpt", "rtept")) {
+                            if (tag == "trkpt" && parent != "trkseg" || tag == "rtept" && parent != "rte") layerFail(LayerStoreError.INVALID_INPUT)
+                            val lat = parser.getAttributeValue(null, "lat")?.toDoubleOrNull() ?: layerFail(LayerStoreError.INVALID_GEOMETRY)
+                            val lon = parser.getAttributeValue(null, "lon")?.toDoubleOrNull() ?: layerFail(LayerStoreError.INVALID_GEOMETRY)
+                            GeoImportCoordinatePolicy.longitudeLatitude(lon, lat, 4326)
+                            currentPoint = mutableListOf(lon, lat); totalPositions++
+                        }
+                    }
+                    if (totalPositions > 200_000) layerFail(LayerStoreError.LIMIT_EXCEEDED)
+                }
+                org.xmlpull.v1.XmlPullParser.TEXT, org.xmlpull.v1.XmlPullParser.CDSECT -> content.append(parser.text.orEmpty())
+                org.xmlpull.v1.XmlPullParser.END_TAG -> {
+                    val tag = stack.lastOrNull() ?: layerFail(LayerStoreError.INVALID_INPUT)
+                    val parent = stack.getOrNull(stack.lastIndex - 1)
+                    if (parent == section && tag in setOf("name", "description", "desc")) fields[if (tag == "desc") "description" else tag] = JsonPrimitive(content.toString())
+                    if (tag == "coordinates" && format == LayerImportFormat.KML && section != null) {
+                        val tuples = content.toString().trim().split(Regex("\\s+")).filter(String::isNotEmpty)
+                        if (geometry == "point" && tuples.size != 1 || geometry == "linestring" && tuples.size < 2 || geometry == "polygon" && tuples.size < 4) layerFail(LayerStoreError.INVALID_GEOMETRY)
+                        val coordinates = tuples.map { tuple ->
+                            val values = tuple.split(',').map { it.toDoubleOrNull()?.takeIf(Double::isFinite) ?: layerFail(LayerStoreError.INVALID_GEOMETRY) }
+                            if (values.size !in 2..3) layerFail(LayerStoreError.INVALID_GEOMETRY)
+                            GeoImportCoordinatePolicy.longitudeLatitude(values[0], values[1], 4326)
+                            values
+                        }
+                        if (geometry == "polygon" && coordinates.firstOrNull() != coordinates.lastOrNull()) layerFail(LayerStoreError.INVALID_GEOMETRY)
+                        totalPositions += coordinates.size; coordinateCount++
+                    }
+                    if (format == LayerImportFormat.GPX) {
+                        if (tag == "ele" && parent in setOf("wpt", "trkpt", "rtept")) {
+                            val altitude = content.toString().toDoubleOrNull()?.takeIf(Double::isFinite) ?: layerFail(LayerStoreError.INVALID_GEOMETRY)
+                            val point = currentPoint ?: layerFail(LayerStoreError.INVALID_GEOMETRY)
+                            if (point.size != 2) layerFail(LayerStoreError.INVALID_GEOMETRY)
+                            point += altitude
+                        }
+                        if (tag in setOf("wpt", "trkpt", "rtept")) {
+                            val position = JsonArray((currentPoint ?: layerFail(LayerStoreError.INVALID_GEOMETRY)).map(::JsonPrimitive))
+                            if (tag == "wpt") waypoint = position else segment += position
+                            currentPoint = null
+                        }
+                        if (tag == "trkseg") { segments += segment.toList(); segment = mutableListOf() }
+                    }
+                    if (tag == section) {
+                        val parsedGeometry = if (format == LayerImportFormat.KML) {
+                            if (geometryCount != 1 || coordinateCount < 1 || geometry != "polygon" && coordinateCount != 1) layerFail(LayerStoreError.INVALID_GEOMETRY)
+                            null
+                        } else when (tag) {
+                            "wpt" -> pointGeometry(waypoint ?: layerFail(LayerStoreError.INVALID_GEOMETRY))
+                            "rte" -> segmentedGeometry(listOf(segment.toList()))
+                            else -> segmentedGeometry(segments)
+                        }
+                        features += XmlFeature(JsonObject(fields.toMap()), parsedGeometry); section = null
+                        if (features.size > MAX_FEATURES) layerFail(LayerStoreError.LIMIT_EXCEEDED)
+                    }
+                    if (totalPositions > 200_000) layerFail(LayerStoreError.LIMIT_EXCEEDED)
+                    stack.removeAt(stack.lastIndex); content.clear()
+                }
+            }
+            event = parser.next()
+        }
+        return features
+    }
