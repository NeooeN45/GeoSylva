+        assertEquals(TraceIgnoredReason.OUT_OF_ORDER_FIX, delayed.reason)
+        assertEquals(TraceCapturePhase.WAITING_FOR_QUALITY, delayed.snapshot.phase)
+        assertEquals(1, delayed.snapshot.acceptedPointCount)
