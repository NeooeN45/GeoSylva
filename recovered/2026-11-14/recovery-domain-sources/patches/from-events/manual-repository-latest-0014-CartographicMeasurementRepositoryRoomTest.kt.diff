+    @Test fun canonical_forest_identity_never_adopts_a_same_named_legacy_group_bucket() = runBlocking {
+        val sharedId = "TEST-colliding-forest-group-id"
+        db.groupDao().insertGroup(GroupEntity(sharedId, "TEST original group"))
+        val legacy = success(repository.captureAccess(MapDataScope.Forest(sharedId)))
+        val oldRecord = success(repository.save(input("TEST legacy snapshot"), legacy))
+        db.openHelper.writableDatabase.execSQL("INSERT INTO forets(foretId,nom,proprietaireNom,createdAt,updatedAt) VALUES(?, 'TEST canonical forest','TEST owner',10,20)", arrayOf(sharedId))
+        failure(CartographicStoreError.ACCESS_CHANGED, repository.read(oldRecord.id, legacy))
+        val canonical = success(repository.captureAccess(MapDataScope.Forest(sharedId)))
+        assertNotEquals(legacy.restorationKey, canonical.restorationKey)
+        assertTrue(success(repository.list(canonical)).isEmpty())
+        failure(CartographicStoreError.UNAVAILABLE, repository.read(oldRecord.id, canonical))
+        val canonicalRecord = success(repository.save(input("TEST canonical snapshot"), canonical))
+        assertEquals("FOREST", db.cartographicMeasurementDao().byId(canonicalRecord.id)?.scopeKind)
+
+        // A known deleted canonical identity cannot expose a group hidden by it.
+        db.foretDao().delete(sharedId, 50)
+        failure(CartographicStoreError.UNAVAILABLE, repository.captureAccess(MapDataScope.Forest(sharedId)))
+        // Dedicated test DB only: remove that canonical identity entirely.
+        db.openHelper.writableDatabase.execSQL("DELETE FROM forets WHERE foretId=?", arrayOf(sharedId))
+        val legacyAgain = success(repository.captureAccess(MapDataScope.Forest(sharedId)))
+        assertEquals(listOf(oldRecord), success(repository.list(legacyAgain)))
+        failure(CartographicStoreError.UNAVAILABLE, repository.read(canonicalRecord.id, legacyAgain))
+        assertEquals(oldRecord, success(repository.read(oldRecord.id, legacyAgain)))
+    }
