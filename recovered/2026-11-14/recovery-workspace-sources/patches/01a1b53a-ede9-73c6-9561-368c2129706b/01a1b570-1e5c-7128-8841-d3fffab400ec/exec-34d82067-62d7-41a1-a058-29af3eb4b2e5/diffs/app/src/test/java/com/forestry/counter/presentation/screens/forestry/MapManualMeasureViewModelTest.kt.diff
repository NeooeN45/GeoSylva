+    @Test fun newMeasureCannotInterruptAnInFlightSaveOrAnUncertainSaveAwaitingRetry() = runTest {
+        val repository = FakeRepository()
+        val finish = CompletableDeferred<Unit>()
+        repository.saveAction = { _, _ ->
+            finish.await()
+            CartographicStoreResult.Failure(CartographicStoreError.UNKNOWN_RESULT)
+        }
+        val model = model(repository)
+        runCurrent(); drawLine(model); runCurrent()
+        model.requestSave(); model.name("TEST · Payload to preserve"); model.confirmSave(); runCurrent()
+        val inFlight = model.state.value
+        assertTrue(inFlight.saving)
+        model.requestNewMeasure()
+        assertEquals(inFlight, model.state.value)
+        finish.complete(Unit); runCurrent()
+        val uncertain = model.state.value
+        assertFalse(uncertain.saving)
+        assertTrue(uncertain.saveLocked)
+        model.requestNewMeasure()
+        assertEquals(uncertain, model.state.value)
+        assertEquals(LINE, model.state.value.distancePoints)
+        assertEquals("TEST · Payload to preserve", model.state.value.saveName)
+        assertEquals(1, repository.inputs.size)
+        assertEquals(0, repository.recordCount())
+    }
