+    @Test fun newMeasureRefusesPendingAuthorityAndAContextThatBecameStaleBeforeItsRefreshWasObserved() = runTest {
+        val repository = FakeRepository()
+        val model = model(repository)
+        val pending = model.state.value
+        assertFalse(pending.ready)
+        model.requestNewMeasure()
+        assertEquals(pending, model.state.value)
+        runCurrent(); drawLine(model); runCurrent()
+        model.open(saved = true); runCurrent()
+        repository.changeOwner("account-B")
+        val stale = model.state.value
+        // The repository already invalidated the access token, while the old
+        // state still has ready=true until the collector gets another turn.
+        assertTrue(stale.ready)
+        model.requestNewMeasure()
+        assertEquals(stale, model.state.value)
+        assertEquals(LINE, model.state.value.distancePoints)
+        runCurrent()
+        assertFalse(model.state.value.active)
+        assertTrue(model.state.value.points.isEmpty())
+        assertTrue(repository.inputs.isEmpty())
+    }
