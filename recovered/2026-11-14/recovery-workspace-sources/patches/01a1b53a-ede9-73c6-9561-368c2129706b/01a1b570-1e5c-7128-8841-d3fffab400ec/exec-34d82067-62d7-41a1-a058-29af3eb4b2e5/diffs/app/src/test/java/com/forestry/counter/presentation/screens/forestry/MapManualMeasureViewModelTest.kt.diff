+    @Test fun newMeasureWithANonemptyDraftRequiresClearAndPreservesBothModesUntilConfirmation() = runTest {
+        val repository = FakeRepository()
+        val model = model(repository)
+        runCurrent(); drawLine(model); runCurrent()
+        model.mode(CartographicMeasureKind.AREA)
+        AREA.forEach { model.addPoint(it.latitude, it.longitude) }
+        runCurrent()
+        val originalArea = available(model).valueSi
+        model.open(saved = true); runCurrent()
+
+        model.requestNewMeasure()
+        assertTrue(model.state.value.active)
+        assertEquals(MeasurePanel.EDITOR, model.state.value.panel)
+        assertEquals(ManualMeasureAuxiliary.CLEAR, model.state.value.auxiliary)
+        assertEquals(AREA, model.state.value.areaPoints)
+        assertEquals(LINE, model.state.value.distancePoints)
+        assertEquals(originalArea, available(model).valueSi, 0.0)
+
+        model.auxiliary(ManualMeasureAuxiliary.NONE)
+        assertEquals(AREA, model.state.value.areaPoints)
+        assertEquals(LINE, model.state.value.distancePoints)
+        model.requestNewMeasure()
+        model.clear(); runCurrent()
+        assertEquals(ManualMeasureAuxiliary.NONE, model.state.value.auxiliary)
+        assertTrue(model.state.value.areaPoints.isEmpty())
+        assertEquals(LINE, model.state.value.distancePoints)
+        assertTrue(repository.inputs.isEmpty())
+        assertEquals(0, repository.recordCount())
+    }
