+/** Reference 18B shares the canvas/panels, but gives Carte libre its quiet dark chrome. */
+@Composable
+private fun FreeContextCapsule(state: MapWorkspaceState, actions: MapWorkspaceActions) {
+    Text(stringResource(R.string.gs_map_free), color = MapUiTokens.freeInk,
+        fontSize = 13.sp, fontWeight = FontWeight.SemiBold, letterSpacing = 1.sp,
+        modifier = Modifier.padding(start = MapUiTokens.iconGap))
+    Surface(shape = MapUiTokens.toolbarShape, color = MapUiTokens.freeChrome,
+        contentColor = MapUiTokens.freeInk, shadowElevation = MapUiTokens.elevation,
+        modifier = Modifier.fillMaxWidth()) {
+        Row(Modifier.heightIn(min = MapUiTokens.touch), verticalAlignment = Alignment.CenterVertically) {
+            IconButton(onClick = actions::onBack, modifier = Modifier.size(MapUiTokens.touch)) {
+                Icon(Icons.AutoMirrored.Filled.ArrowBack, stringResource(R.string.gs_map_back))
+            }
+            val label = state.contextActionLabel ?: stringResource(R.string.gs_map_explore)
+            Row(Modifier.weight(1f).heightIn(min = MapUiTokens.touch)
+                .clickable(role = Role.Button, onClickLabel = label, onClick = actions::onChooseContext)
+                .padding(end = MapUiTokens.commandPadding),
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.spacedBy(MapUiTokens.iconGap)) {
+                Text(label, Modifier.weight(1f), fontSize = 16.sp,
+                    fontWeight = FontWeight.Medium)
+                Icon(Icons.Outlined.Search, null, Modifier.size(MapUiTokens.icon))
+            }
+        }
+    }
+}
