+        assertNull(fixture.controller.state.value.snapshot)
+        assertNull(fixture.controller.currentSourceToken())
+        assertFalse(fixture.controller.sourceActive.value)
+        fixture.controller.acceptFix(oldToken, fixture.fix(45.002)); fixture.controller.resume(); runCurrent()
+        assertNull(fixture.controller.state.value.snapshot)
