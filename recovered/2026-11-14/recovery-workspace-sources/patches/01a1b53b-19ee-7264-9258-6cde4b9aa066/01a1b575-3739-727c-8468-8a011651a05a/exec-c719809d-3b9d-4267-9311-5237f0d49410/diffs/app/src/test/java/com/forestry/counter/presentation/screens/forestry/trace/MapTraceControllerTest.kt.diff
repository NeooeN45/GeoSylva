+        fixture.controller.start()
+        val stopping = launch(start = CoroutineStart.UNDISPATCHED) { fixture.controller.stopForPurge() }
+        assertFalse(stopping.isCompleted)
+        assertFalse(fixture.controller.authorityIsCurrent())
+        fixture.controller.open(MapDataScope.Parcel("during-purge"))
+        fixture.controller.start(); fixture.controller.resume()
+        assertEquals(CartographicStoreResult.Failure(CartographicStoreError.ACCESS_CHANGED), fixture.controller.exportPreview("ignored", 1))
+        fixture.repository.draftGate?.complete(Unit); runCurrent()
