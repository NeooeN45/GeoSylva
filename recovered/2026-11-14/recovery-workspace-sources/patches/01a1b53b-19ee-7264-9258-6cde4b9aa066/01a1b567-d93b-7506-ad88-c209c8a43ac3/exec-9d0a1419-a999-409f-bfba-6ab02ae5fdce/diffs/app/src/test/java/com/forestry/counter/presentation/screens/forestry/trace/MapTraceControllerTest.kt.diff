+    @Test fun `source flow excludes map GPS throughout suspended start and resume persistence`() = runTest {
+        val fixture = Fixture(this)
+        val observed = mutableListOf<Boolean>()
+        backgroundScope.launch(UnconfinedTestDispatcher(testScheduler)) { fixture.controller.sourceActive.toList(observed) }
+        fixture.controller.open(MapDataScope.Parcel("p")); runCurrent()
+        fixture.repository.draftGate = CompletableDeferred()
+        fixture.controller.start(); runCurrent()
+        assertTrue(fixture.controller.sourceActive.value)
+        assertNull(fixture.controller.currentSourceToken())
+        assertTrue(fixture.source.starts.isEmpty())
+        assertEquals(listOf(false, true), observed)
+        fixture.source.onStart = { assertTrue(fixture.controller.sourceActive.value) }
+        fixture.source.onStop = { assertTrue("The map claim must outlive source.stop", fixture.controller.sourceActive.value) }
+        fixture.repository.draftGate?.complete(Unit); runCurrent()
+        assertEquals(1, fixture.source.starts.size)
+        fixture.controller.pause(); runCurrent()
+        assertFalse(fixture.controller.sourceActive.value)
+
+        fixture.repository.draftGate = CompletableDeferred()
+        fixture.controller.resume(); runCurrent()
+        assertTrue(fixture.controller.sourceActive.value)
+        assertNull(fixture.controller.currentSourceToken())
+        assertEquals(1, fixture.source.starts.size)
+        fixture.repository.draftFailure = CartographicStoreError.IO
+        fixture.repository.draftGate?.complete(Unit); runCurrent()
+        assertFalse(fixture.controller.sourceActive.value)
+        assertNull(fixture.controller.currentSourceToken())
+        assertEquals(1, fixture.source.starts.size)
+        assertEquals(listOf(false, true, false, true, false), observed)
+
+        fixture.repository.draftFailure = null
+        fixture.source.startSucceeds = false
+        fixture.controller.resume(); runCurrent()
+        assertFalse(fixture.controller.sourceActive.value)
+        assertNull(fixture.controller.currentSourceToken())
+    }
