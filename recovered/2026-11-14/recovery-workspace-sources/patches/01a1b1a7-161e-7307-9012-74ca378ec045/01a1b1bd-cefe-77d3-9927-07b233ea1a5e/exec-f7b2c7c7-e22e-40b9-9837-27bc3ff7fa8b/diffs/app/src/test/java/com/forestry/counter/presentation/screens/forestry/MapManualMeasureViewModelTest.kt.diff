+    @Test fun returningToTheDraftDropsItsOldSavedSelectionBeforeAnotherShare() = runTest {
+        val repository = FakeRepository()
+        repository.seed(RECORD_B, "Saved B", LINE.map { it.copy(longitude = it.longitude + .01) })
+        val model = model(repository)
+        runCurrent(); drawLine(model); runCurrent()
+        model.selectSaved(RECORD_B); runCurrent()
+        assertEquals(RECORD_B, model.state.value.selected?.id)
+        model.auxiliary(ManualMeasureAuxiliary.NONE)
+        assertNull(model.state.value.selected)
+        assertEquals(LINE, model.state.value.points)
+        val shared = mutableListOf<String>()
+        model.auxiliary(ManualMeasureAuxiliary.SHARE)
+        model.withSelectedRecord { shared += it.id }; runCurrent()
+        assertTrue(shared.isEmpty())
+    }
