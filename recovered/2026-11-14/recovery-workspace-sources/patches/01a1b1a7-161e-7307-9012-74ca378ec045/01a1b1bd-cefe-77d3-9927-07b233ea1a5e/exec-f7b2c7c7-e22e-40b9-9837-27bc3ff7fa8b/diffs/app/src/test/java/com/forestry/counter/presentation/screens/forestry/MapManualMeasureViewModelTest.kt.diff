+    @Test fun closingListOrDetailImmediatelyStopsLoadingAndIgnoresLateResponses() = runTest {
+        val repository = FakeRepository()
+        val record = repository.seed(RECORD_A, "Saved A", LINE)
+        val pendingList = CompletableDeferred<CartographicStoreResult<List<SavedCartographicMeasurement>>>()
+        repository.listAction = { pendingList.await() }
+        val model = model(repository)
+        runCurrent(); model.openSaved(); runCurrent()
+        assertTrue(model.state.value.loadingSaved)
+        model.auxiliary(ManualMeasureAuxiliary.NONE)
+        assertFalse(model.state.value.loadingSaved)
+        pendingList.complete(CartographicStoreResult.Success(listOf(record))); runCurrent()
+        assertFalse(model.state.value.loadingSaved)
+        assertEquals(ManualMeasureAuxiliary.NONE, model.state.value.auxiliary)
+        val pendingRead = CompletableDeferred<CartographicStoreResult<SavedCartographicMeasurement>>()
+        repository.readAction = { _, _ -> pendingRead.await() }
+        model.selectSaved(RECORD_A); runCurrent()
+        assertTrue(model.state.value.loadingSaved)
+        model.auxiliary(ManualMeasureAuxiliary.NONE)
+        assertFalse(model.state.value.loadingSaved)
+        pendingRead.complete(CartographicStoreResult.Success(record)); runCurrent()
+        assertFalse(model.state.value.loadingSaved)
+        assertNull(model.state.value.selected)
+    }
