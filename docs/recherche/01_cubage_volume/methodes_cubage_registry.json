      "method_id": "STERE_EMPILAGE",
      "label_fr": "Volume apparent de bois empilé",
      "object_type": "stack",
      "formula": "V_apparent = length * width * height; V_real = V_apparent * stacking_factor",
      "table_required": true,
      "inputs": ["stack_length", "stack_width", "stack_height", "piece_length", "stacking_quality", "stacking_factor"],
