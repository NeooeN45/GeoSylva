{
  "schema_version": "0.1.0",
  "status": "Draft",
  "purpose": "Registre préparatoire à la traduction Kotlin des méthodes de cubage.",
  "rules": [
    "Une méthode n'est pas implémentable sans formule ou table, unités, volume_kind, domaine et source.",
    "Un coefficient absent ne doit pas être remplacé par une valeur proche.",
    "Les méthodes de grumes et les tarifs d'arbres sur pied sont des familles distinctes."
  ],
  "methods": [
    {
      "method_id": "GEOM_CYLINDER",
      "label_fr": "Cylindre",
      "object_type": "log_or_segment",
      "formula": "V = pi * D^2 / 4 * L",
      "inputs": ["diameter_m", "length_m"],
      "output": "m3_real",
      "scope": "universal_approximation",
      "status": "A_FORMULE_VERIFIEE",
      "sources": ["GEOSYLVA-RECH-CUBAGE-006"]
    },
    {
      "method_id": "GEOM_CONE",
      "label_fr": "Tronc de cône",
      "object_type": "log_or_segment",
      "formula": "V = pi * L * (D_base^2 + D_base * D_top + D_top^2) / 12",
      "inputs": ["diameter_base_m", "diameter_top_m", "length_m"],
      "output": "m3_real",
      "scope": "universal_linear_taper_approximation",
      "status": "A_FORMULE_VERIFIEE",
      "sources": ["GEOSYLVA-RECH-CUBAGE-006"]
    },
    {
      "method_id": "LOG_HUBER",
      "label_fr": "Huber",
      "object_type": "log",
      "formula": "V = L * pi * D_mid^2 / 4",
      "inputs": ["diameter_mid_m", "length_m"],
      "output": "m3_real",
      "scope": "direct_log_measurement",
      "status": "A_FORMULE_VERIFIEE",
      "sources": ["GEOSYLVA-RECH-CUBAGE-006"]
    },
    {
      "method_id": "LOG_SMALIAN",
      "label_fr": "Smalian",
      "object_type": "log",
      "formula": "V = L * (A_base + A_top) / 2",
      "inputs": ["diameter_base_m", "diameter_top_m", "length_m"],
      "output": "m3_real",
      "scope": "direct_log_measurement",
      "status": "A_FORMULE_VERIFIEE",
      "sources": ["GEOSYLVA-RECH-CUBAGE-006"]
    },
    {
      "method_id": "LOG_NEWTON",
      "label_fr": "Newton ou Simpson",
      "object_type": "log",
      "formula": "V = L * (A_base + 4 * A_mid + A_top) / 6",
      "inputs": ["diameter_base_m", "diameter_mid_m", "diameter_top_m", "length_m"],
      "output": "m3_real",
      "scope": "direct_log_measurement",
      "status": "A_FORMULE_VERIFIEE",
      "sources": ["GEOSYLVA-RECH-CUBAGE-006"]
    },
    {
      "method_id": "ALGAN_1E",
      "label_fr": "Tarifs Algan historiques",
      "object_type": "standing_tree_or_stand",
      "formula": null,
      "table_required": true,
      "inputs": ["diameter_or_circumference_130", "tariff_number"],
      "output": "standing_estimate",
      "scope": "France; population_calibrated",
      "species_scope": "feuillus_and_resineux selon table",
      "status": "C_SOURCE_PARTIELLE",
      "sources": ["https://doi.org/10.4267/2042/26629", "http://jymassenet-foret.fr/cours/dendrometrie/Coursdendrometriepdf/DENDRO6-2007.pdf"]
    },
    {
      "method_id": "SCHAEFFER_FAST",
      "label_fr": "Schaeffer rapide",
      "object_type": "standing_tree_or_stand",
      "formula": "V = M / 1400 * (D - 5) * (D - 10)",
      "inputs": ["diameter_130_cm", "reference_volume_M_m3", "tariff_number"],
      "output": "standing_estimate",
      "scope": "France; heterogeneous_or_jardined_stands",
      "status": "B_TABLE_SOURCEE",
      "qualification_note": "Forme historique à confronter à l'édition primaire et à la convention du numéro.",
      "sources": ["https://doi.org/10.4267/2042/26629", "http://jymassenet-foret.fr/cours/dendrometrie/Coursdendrometriepdf/DENDRO6-2007.pdf"]
    },
    {
      "method_id": "SCHAEFFER_SLOW",
      "label_fr": "Schaeffer lent",
      "object_type": "standing_tree_or_stand",
      "formula": "V = M / 1800 * D * (D - 5)",
      "inputs": ["diameter_130_cm", "reference_volume_M_m3", "tariff_number"],
      "output": "standing_estimate",
      "scope": "France; homogeneous_even_aged_stands",
      "status": "B_TABLE_SOURCEE",
      "qualification_note": "Forme historique à confronter à l'édition primaire et à la convention du numéro.",
      "sources": ["https://doi.org/10.4267/2042/26629", "http://jymassenet-foret.fr/cours/dendrometrie/Coursdendrometriepdf/DENDRO6-2007.pdf"]
    },
